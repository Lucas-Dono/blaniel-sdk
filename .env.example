# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/blaniel

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Authentication (must match Next.js backend)
JWT_SECRET=your-jwt-secret-here

# Next.js Backend Integration
NEXTJS_API_URL=http://localhost:3000
NEXTJS_API_KEY=your-service-to-service-api-key

# Server Configuration
PORT=3001
RUST_LOG=info,rust_npc_api=debug

# Cache Configuration
MEMORY_CACHE_SIZE=1000
REDIS_POOL_SIZE=10

# Performance Tuning
DB_POOL_MAX_CONNECTIONS=50
DB_POOL_MIN_CONNECTIONS=10
DB_ACQUIRE_TIMEOUT_SECS=5

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_SECOND=10
RATE_LIMIT_BURST_SIZE=20

# AI Providers (for sub-20ms responses)
# Venice AI - Uncensored models
VENICE_API_KEY=your_venice_api_key_here
VENICE_MODEL=venice-uncensored-role-play

# Together.ai - Fast inference (optional)
# TOGETHER_API_KEY=your_together_api_key_here
# TOGETHER_MODEL=meta-llama/Llama-3-8b-chat-hf

# Webhook Security (IMPORTANT: Change in production!)
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=change-this-in-production-use-openssl-rand
